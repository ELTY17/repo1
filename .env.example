# Copia esto a .env y NUNCA lo subas al repositorio.
#
# La API key de Kraken se crea en Configuración → API. Márcale SOLO estos permisos:
#   ✓ Query Funds        ✓ Query Open/Closed Orders      ✓ Create & Modify Orders
#   ✗ Withdraw Funds  ← jamás. Sin este permiso, una clave robada no puede sacar
#                        el dinero de la cuenta.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Para que --real ejecute de verdad. Sin esto, solo valida.
# LIVE_TRADING_CONFIRMED=yes-i-understand-the-risk

# Opcional: webhook (Discord, Slack...) para los avisos.
# ALERT_WEBHOOK=
